# Copy to .env (never commit .env). Add only platform apps you have registered.
FLASK_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SERPAPI_API_KEY=

# Provider OAuth credentials. Register each callback URL exactly as shown below.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8890/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8890/auth/facebook/callback
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts

THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://127.0.0.1:8890/auth/threads/callback
THREADS_SCOPES=threads_basic,threads_content_publish,threads_manage_insights

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8890/auth/linkedin/callback
LINKEDIN_SCOPES=openid,profile,w_member_social
LINKEDIN_VERSION=202601

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8890/auth/x/callback
X_SCOPES=tweet.read,users.read,tweet.write,offline.access

TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://127.0.0.1:8890/auth/tiktok/callback
TIKTOK_SCOPES=user.info.basic,video.list,video.publish

YOUTUBE_SHORTS_CLIENT_ID=
YOUTUBE_SHORTS_CLIENT_SECRET=
YOUTUBE_SHORTS_REDIRECT_URI=http://127.0.0.1:8890/auth/youtube_shorts/callback
YOUTUBE_SHORTS_SCOPES=openid,profile,https://www.googleapis.com/auth/youtube.upload,https://www.googleapis.com/auth/youtube.readonly

PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://127.0.0.1:8890/auth/pinterest/callback
PINTEREST_SCOPES=user_accounts:read,pins:read,pins:write,boards:read
